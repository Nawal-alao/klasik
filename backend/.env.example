# Copier ce fichier en `.env` (à la racine de backend/) puis renseigner
# les vraies valeurs. Ne JAMAIS committer de vraies clés ou mots de passe.

DJANGO_SECRET_KEY='django-insecure-CHANGER-MOI'
COHERE_API_KEY='VOTRE_CLE_API_COHERE'

# Optional app/runtime settings already used by the project
DEBUG=True
EMAIL_BACKEND='django.core.mail.backends.console.EmailBackend'

# Database — PostgreSQL local (par défaut)
DB_NAME='evoly_db'
DB_USER='evoly_user'
DB_PASSWORD='MOT_DE_PASSE_A_CHANGER'
DB_HOST=localhost
DB_PORT=5432

# Développement local avec SQLite à la place :
# DB_ENGINE='django.db.backends.sqlite3'

# --- Production (Render) — à définir uniquement dans le dashboard Render ---
# DJANGO_ALLOWED_HOSTS='.onrender.com'
# CORS_ALLOWED_ORIGINS='https://evoly.vercel.app,https://evoly-api.onrender.com'
# CSRF_TRUSTED_ORIGINS='https://evoly.vercel.app,https://evoly-api.onrender.com'

# Supabase Storage (S3) — médias uploadés (images CKEditor des cours).
# Sans ces variables, les médias restent sur le disque local (dev uniquement ;
# PERDUS à chaque redéploiement sur Render).
# AWS_S3_ENDPOINT_URL='https://<project-ref>.supabase.co/storage/v1/s3'
# AWS_STORAGE_BUCKET_NAME='evoly-media'
# AWS_ACCESS_KEY_ID='VOTRE_CLE_S3_SUPABASE'
# AWS_SECRET_ACCESS_KEY='VOTRE_SECRET_S3_SUPABASE'
# AWS_S3_REGION_NAME='eu-west-3'
